-- ============================================================
-- Brazilian Live Cattle Exports — medidas principais
-- Modelo esperado:
-- dCalendario[Data] 1:* fato_exportacao_bovinos[data]
-- dUF[uf]           1:* fatos de exportação e rebanho
-- dPais[pais]       1:* fato_exportacao_bovinos[pais_destino]
-- dNCM[ncm]         1:* fato_exportacao_bovinos[ncm]
-- ============================================================

Cabeças Exportadas =
SUM ( fato_exportacao_bovinos[cabecas_exportadas] )

Valor FOB USD =
SUM ( fato_exportacao_bovinos[valor_fob_usd] )

Peso Líquido Kg =
SUM ( fato_exportacao_bovinos[kg_liquido] )

Valor Médio USD por Cabeça =
DIVIDE ( [Valor FOB USD], [Cabeças Exportadas] )

Peso Médio Kg por Cabeça =
DIVIDE ( [Peso Líquido Kg], [Cabeças Exportadas] )

Rebanho Bovino =
SUM ( fato_rebanho_bovino[rebanho_bovino_cabecas] )

Exportações % do Rebanho =
DIVIDE ( [Cabeças Exportadas], [Rebanho Bovino] )

Rebanho por Cabeça Exportada =
DIVIDE ( [Rebanho Bovino], [Cabeças Exportadas] )

-- Inteligência temporal -----------------------------------------------------

Valor FOB Ano Anterior =
CALCULATE (
    [Valor FOB USD],
    DATEADD ( dCalendario[Data], -1, YEAR )
)

Variação FOB YoY % =
DIVIDE (
    [Valor FOB USD] - [Valor FOB Ano Anterior],
    [Valor FOB Ano Anterior]
)

Cabeças Ano Anterior =
CALCULATE (
    [Cabeças Exportadas],
    DATEADD ( dCalendario[Data], -1, YEAR )
)

Variação Cabeças YoY % =
DIVIDE (
    [Cabeças Exportadas] - [Cabeças Ano Anterior],
    [Cabeças Ano Anterior]
)

Valor FOB YTD =
TOTALYTD ( [Valor FOB USD], dCalendario[Data] )

Cabeças YTD =
TOTALYTD ( [Cabeças Exportadas], dCalendario[Data] )

Valor FOB YTD Ano Anterior =
CALCULATE (
    [Valor FOB YTD],
    DATEADD ( dCalendario[Data], -1, YEAR )
)

Cabeças YTD Ano Anterior =
CALCULATE (
    [Cabeças YTD],
    DATEADD ( dCalendario[Data], -1, YEAR )
)

Variação FOB YTD YoY % =
DIVIDE (
    [Valor FOB YTD] - [Valor FOB YTD Ano Anterior],
    [Valor FOB YTD Ano Anterior]
)

Variação Cabeças YTD YoY % =
DIVIDE (
    [Cabeças YTD] - [Cabeças YTD Ano Anterior],
    [Cabeças YTD Ano Anterior]
)

-- Participação e ranking ---------------------------------------------------

Participação Destino % =
DIVIDE (
    [Valor FOB USD],
    CALCULATE ( [Valor FOB USD], REMOVEFILTERS ( dPais ) )
)

Participação Região % Cabeças =
DIVIDE (
    [Cabeças Exportadas],
    CALCULATE ( [Cabeças Exportadas], REMOVEFILTERS ( dUF[regiao] ) )
)

Ranking País por FOB =
RANKX (
    ALLSELECTED ( dPais[pais_destino] ),
    [Valor FOB USD],
    ,
    DESC,
    DENSE
)

Ranking UF por Cabeças =
RANKX (
    ALLSELECTED ( dUF[uf] ),
    [Cabeças Exportadas],
    ,
    DESC,
    DENSE
)

-- Indicadores auxiliares ---------------------------------------------------

Máximo Mês com Dados =
MAX ( dCalendario[Data] )

Texto Período Selecionado =
VAR DataMax = MAX ( dCalendario[Data] )
VAR AnoMax = YEAR ( DataMax )
VAR MesMax = MONTH ( DataMax )
RETURN
    IF (
        AnoMax = 2026,
        "Jan–" & FORMAT ( DataMax, "mmm" ) & "/" & AnoMax,
        FORMAT ( AnoMax, "0" )
    )
